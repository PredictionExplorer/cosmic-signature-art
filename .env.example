# Gallery reads the existing public indexer; no secrets are required.
# Leave empty until the reviewed immutable auction is deployed.
NEXT_PUBLIC_AUCTION_ADDRESS=
# keccak256 of the deployed immutable auction runtime, verified during release.
NEXT_PUBLIC_AUCTION_CODE_HASH=
NEXT_PUBLIC_RPC_URL=https://arb1.arbitrum.io/rpc
NEXT_PUBLIC_CHAIN_ID=42161
# Canonical origin for links, hreflang alternates, robots and the sitemap. Share-card
# images follow the serving deployment on Vercel automatically, so cards keep their
# image while cosmic.art's DNS is pending; set this to the Vercel URL to make links match.
NEXT_PUBLIC_SITE_URL=https://cosmic.art
