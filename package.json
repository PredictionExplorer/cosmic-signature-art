{
  "name": "cosmic-signature-art",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4318",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4318",
    "type-check": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:scripts": "node --experimental-strip-types --test 'scripts/**/*.test.mjs'",
    "art:previews": "node scripts/build-collection-previews.mjs",
    "art:plates": "node scripts/build-plate-records.mjs",
    "art:clips": "node scripts/build-plate-clips.mjs",
    "art:ladder": "node scripts/build-still-ladder.mjs",
    "art:inline": "node scripts/build-inline-previews.mjs",
    "test:e2e": "playwright test",
    "test:auction-ui": "playwright test --config tests/auction-harness/playwright.config.ts",
    "test:auction-ui:types": "tsc --noEmit -p tests/auction-harness/tsconfig.json",
    "test:auction:local": "node scripts/run-local-auction-rehearsal.mjs",
    "test:auction:local:types": "tsc --noEmit -p tests/real-auction/tsconfig.json",
    "format:check": "prettier --check src tests scripts *.ts *.mjs *.json",
    "audit": "npm audit --omit=dev",
    "predev": "npm run fonts",
    "prebuild": "npm run fonts",
    "fonts": "node scripts/build-font-subsets.mjs",
    "test:fonts": "node scripts/check-font-coverage.mjs",
    "art:index": "node scripts/build-collection-index.mjs",
    "art:orbits": "node --experimental-strip-types scripts/build-orbit-records.mjs",
    "art:windows": "node --experimental-strip-types scripts/build-orbit-windows.mjs",
    "art:arrival": "node scripts/build-arrival-maps.mjs",
    "art:light": "node scripts/build-all-the-light.mjs"
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/gowun-batang": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/literata": "5.3.0",
    "@fontsource/noto-serif-hk": "^5.3.1",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@fontsource/noto-serif-tc": "^5.3.1",
    "@fontsource/shippori-mincho-b1": "^5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwindcss": "4.3.3",
    "viem": "^2.50.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4",
    "jsdom": "^27",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "type": "module"
}
